# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Xcode / XcodeGen #
####################
# The .xcodeproj is generated from AppAccessToggle/project.yml via
# `xcodegen generate` - it isn't committed, only the spec that produces it.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
.build/
.swiftpm/
*.moved-aside
*.xcuserstate
